# Production .env plan for the Hostel Booking System (Laravel version).
# On Render these are set as environment variables (no .env file).
# Elsewhere: copy to .env on the server, fill in the blanks, then run:
#   composer install --no-dev --optimize-autoloader
#   php artisan key:generate        (first deploy only)
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#   npm ci && npm run build

APP_NAME="Hostel Booking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false                 # never show stack traces to the public
APP_URL=https://your-domain.example

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The live site uses Neon Postgres: paste its connection string into DB_URL.
DB_CONNECTION=pgsql
DB_PORT=5432
DB_URL=                         # postgresql://user:password@host/dbname?sslmode=require

# Demo account passwords for the live site (different from the local ones)
DEMO_WARDEN_PASSWORD=
DEMO_STUDENT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true      # cookies only over HTTPS
SESSION_ENCRYPT=true

FILESYSTEM_DISK=public
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
