# Production .env plan for the Hostel Booking System (Laravel version).
# Copy to .env on the server, fill in the blanks, then run:
#   composer install --no-dev --optimize-autoloader
#   php artisan key:generate        (first deploy only)
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#   npm ci && npm run build

APP_NAME="Hostel Booking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false                 # never show stack traces to the public
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hostel_booking
DB_USERNAME=hostel_app          # a dedicated user, not root
DB_PASSWORD=                    # a long random password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true      # cookies only over HTTPS
SESSION_ENCRYPT=true

FILESYSTEM_DISK=public
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
